import "go:slices"

// P0 regression tests from the engineering review.

#[test]
fn hamt_large_map_crosses_hash_partitions() {
    let mut m = empty_map<int, int>()
    for i in 0..200 { m = massoc(m, i, i * 10) }
    assert m.n == 200
    for i in 0..200 {
        assert mget(m, i) == Some(i * 10)
    }
    let updated = massoc(m, 7, 999)
    assert mget(updated, 7) == Some(999)
    assert mget(m, 7) == Some(70)       // structural persistence
    let removed = mdissoc(m, 7)
    assert mget(removed, 7) == None
    assert mget(m, 7) == Some(70)
    assert entries(m).length() == 200
}

#[test]
fn vector_boundary_31_32_33() {
    let mut v = empty_vector<int>()
    for i in 0..33 { v = vconj(v, i) }
    assert vnth(v, 30) == Some(30)
    assert vnth(v, 31) == Some(31)
    assert vnth(v, 32) == Some(32)
    assert vnth(v, 33) == None
}

#[test]
fn vector_boundary_1023_1024_1025() {
    let mut v = empty_vector<int>()
    for i in 0..1025 { v = vconj(v, i) }
    assert vnth(v, 1022) == Some(1022)
    assert vnth(v, 1023) == Some(1023)
    assert vnth(v, 1024) == Some(1024)
    assert vnth(v, 1025) == None
}

#[test]
fn vector_versions_are_independent() {
    let mut base = empty_vector<int>()
    for i in 0..40 { base = vconj(base, i) }
    let a = vconj(base, 100)
    let b = vconj(base, 200)
    assert vnth(a, 0) == Some(0)
    assert vnth(a, 40) == Some(100)
    assert vnth(b, 40) == Some(200)
    assert vnth(base, 40) == None
    assert vnth(base, 0) == Some(0)
}

#[test]
fn take_stops_immediately_after_nth() {
    // take(2) must not pull a third element: an effect counter would see only 2.
    let stages = [Stage {
        apply: |st: RState, x: int| (st, Some(x), Reduced.Continue),
    }]
    let pipeline = compose(take(2), Pipeline { stages })
    let out = run(pipeline, [1, 2, 3, 4])
    assert slices.Equal(out, [1, 2])
}

#[test]
fn list_count_iterative_long() {
    let mut xs = empty_list<int>()
    for i in 0..5000 { xs = cons(i, xs) }
    assert list_count(xs) == 5000
}

#[test]
fn smap_replace_does_not_inflate_count() {
    let mut m = empty_smap<int>()
    m = sassoc(m, "a", 1)
    m = sassoc(m, "a", 2)
    assert scount(m) == 1
    assert sget(m, "a") == Some(2)
}

#[test]
fn smap_take_stage_is_global_limit() {
    let mut m = empty_smap<int>()
    for i in 0..100 { m = sassoc(m, f"k{i}", i) }
    let stages = [Stage { apply: |st: RState, k: string| (st, Some(k), Reduced.Continue) }]
    let pipeline = compose(take(3), Pipeline { stages })
    // transduce_keys is int->int; use a counting f and a global take pipeline.
    let seen = transduce_keys(m, pipeline.stages, 0, |acc: int, _k: string| acc + 1)
    assert seen == 3
}

#[test]
fn vector_height_transition_32768() {
    let mut v = empty_vector<int>()
    for i in 0..32769 { v = vconj(v, i) }
    assert vnth(v, 32767) == Some(32767)
    assert vnth(v, 32768) == Some(32768)
    assert vnth(v, 32769) == None
}

#[test]
fn queue_reduce_includes_rear() {
    // Enqueue while front stays non-empty: reduce must see front ++ reverse(rear).
    let mut q = empty_queue<int>()
    q = qconj(q, 1)
    q = qconj(q, 2)
    q = qconj(q, 3)
    assert q.reduce(0, |acc: int, x: int| acc + x) == 6
    assert qpeek(q) == Some(1)
}

#[test]
fn take_zero_emits_nothing() {
    assert eq_slice(take_collect([1, 2, 3], 0), [])
    assert eq_slice(take_collect([1, 2, 3], -1), [])
    assert eq_slice(take_collect([1, 2, 3], 2), [1, 2])
}

#[test]
fn smap_bulk_load_preserves_entries() {
    let mut entries = Slice.new<(string, int)>()
    for i in 0..100 { entries = entries.append((f"k{i}", i)) }
    let m = from_entries(entries)
    assert scount(m) == 100
    for i in 0..100 { assert sget(m, f"k{i}") == Some(i) }
}

#[test]
fn generic_map_with_custom_hash_policy() {
    let m = empty_map_with<int, int>(|k: int| (k as uint64) * 2654435761)
    let m2 = massoc(m, 42, 7)
    assert mget(m2, 42) == Some(7)
    assert mget(m2, 43) == None
}

#[test]
fn direct_smap_transduction_no_intermediate() {
    let mut m = empty_smap<int>()
    for i in 0..50 { m = sassoc(m, f"k{i}", i) }
    let stages = [Stage { apply: |st: RState, k: string| (st, Some(k), Reduced.Continue) }]
    let pipeline = compose(take(3), Pipeline { stages })
    assert transduce_keys(m, pipeline.stages, 0, |acc: int, _k: string| acc + 1) == 3
}
