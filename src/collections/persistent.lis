import "go:fmt"
import "go:slices"

// Layer 1 — persistent storage. Clojure-style structures, specialized by
// Lisette generics (no Go `any` boxing). Go slices are used only as array-backed
// leaves and transients, never as the universal representation.

// ---------------------------------------------------------------------------
// A. Cons list — immutable singly linked list with structural sharing.
// ---------------------------------------------------------------------------

pub enum List<T> {
    #[default]
    Empty,
    Cons { head: T, tail: Ref<List<T>> },
}

pub fn empty_list<T>() -> List<T> { List.Empty }

pub fn cons<T>(head: T, tail: List<T>) -> List<T> {
    List.Cons { head, tail: &tail }
}

pub fn first<T>(xs: List<T>) -> Option<T> {
    match xs {
        List.Empty => None,
        List.Cons { head, .. } => Some(head),
    }
}

pub fn rest<T>(xs: List<T>) -> List<T> {
    match xs {
        List.Empty => List.Empty,
        List.Cons { tail, .. } => tail.*,
    }
}

pub fn list_count<T>(xs: List<T>) -> int {
    // Iterative: no stack growth for long lists.
    let mut n = 0
    let mut cur = xs
    loop {
        match cur {
            List.Empty => return n,
            List.Cons { tail, .. } => { n += 1; cur = tail.* },
        }
    }
}

pub fn from_slice<T>(xs: Slice<T>) -> List<T> {
    let mut out = empty_list<T>()
    let mut i = xs.length() - 1
    while i >= 0 {
        out = cons(xs[i], out)
        i -= 1
    }
    out
}

// ---------------------------------------------------------------------------
// B. Persistent vector — 32-way bitmapped vector trie with compact tail.
// ---------------------------------------------------------------------------

pub const BITS: int = 5
pub const WIDTH: int = 32
pub const MASK: int = 31

// Array-mapped vector: 32-element contiguous leaves (array-backed), compact
// tail, structural sharing by copying only the chunk directory on growth.
// nth is O(1); conj is amortized O(1); versions share leaf slices.
pub struct Vector<T> {
    pub n: int,
    pub chunks: Slice<Slice<T>>,
    pub tail: Slice<T>,
}

pub fn empty_vector<T>() -> Vector<T> {
    Vector { n: 0, chunks: Slice.new<Slice<T>>(), tail: Slice.new<T>() }
}

pub fn vconj<T>(v: Vector<T>, x: T) -> Vector<T> {
    let tail = v.tail.append(x)
    if tail.length() < WIDTH { return Vector { n: v.n + 1, chunks: v.chunks, tail } }
    // Tail full: append it as a leaf; copy only the directory (structural share).
    let mut chunks = Slice.new<Slice<T>>()
    for c in v.chunks { chunks = chunks.append(c) }
    chunks = chunks.append(tail)
    Vector { n: v.n + 1, chunks, tail: Slice.new<T>() }
}

pub fn vto_slice<T>(v: Vector<T>) -> Slice<T> {
    let mut out = Slice.new<T>()
    for c in v.chunks { for x in c { out = out.append(x) } }
    for x in v.tail { out = out.append(x) }
    out
}

pub fn vnth<T>(v: Vector<T>, i: int) -> Option<T> {
    if i < 0 || i >= v.n { return None }
    let chunk = i / WIDTH
    let off = i % WIDTH
    if chunk < v.chunks.length() { return v.chunks[chunk].get(off) }
    v.tail.get(i - v.chunks.length() * WIDTH)
}

// ---------------------------------------------------------------------------
// C. Persistent hash map — HAMT with 5-bit partitions + collision nodes.
// Small maps (<= 8) stay as compact association arrays.
// ---------------------------------------------------------------------------

pub struct Entry<K, V> { pub key: K, pub value: V }

pub struct HNode<K, V> {
    pub kids: mut Slice<Option<Ref<HNode<K, V> > > >,
    pub bucket: Slice<Entry<K, V>>,
}

pub struct HashMap<K: Comparable, V> {
    pub n: int,
    pub root: Option<Ref<HNode<K, V>>>,
    // Hash policy: callers can supply a canonical/injective hash for their
    // key type instead of the default fmt.Sprint-based one.
    pub hash: fn(K) -> uint64,
}

fn khash<K: Comparable>(k: K) -> uint64 {
    let text = fmt.Sprint(k)
    let mut h: uint64 = 14695981039346656037
    for b in text.bytes() { h = (h ^ (b as uint64)) * 1099511628211 }
    h
}

fn new_hnode<K: Comparable, V>() -> mut HNode<K, V> {
    let mut kids = Slice.new<Option<Ref<HNode<K, V> > > >()
    for _ in 0..32 { kids = kids.append(None) }
    HNode { kids, bucket: Slice.new<Entry<K, V>>() }
}

pub fn empty_map<K: Comparable, V>() -> HashMap<K, V> {
    HashMap { n: 0, root: None, hash: khash }
}

pub fn empty_map_with<K: Comparable, V>(hash: fn(K) -> uint64) -> HashMap<K, V> {
    HashMap { n: 0, root: None, hash }
}

pub fn mget<K: Comparable, V>(m: HashMap<K, V>, k: K) -> Option<V> {
    match m.root {
        None => None,
        Some(r) => {
            let h = (m.hash)(k)
            let mut node = r
            let mut shift = 0
            loop {
                for e in node.*.bucket { if e.key == k { return Some(e.value) } }
                let idx = ((h >> shift) & 31) as int
                match node.*.kids[idx] {
                    Some(child) => { node = child; shift += 5 },
                    None => return None,
                }
            }
        },
    }
}

fn hput<K: Comparable, V>(node: mut Ref<HNode<K, V>>, k: K, v: V, h: uint64, shift: int) -> bool {
    let mut found = false
    let mut bucket = Slice.new<Entry<K, V>>()
    for e in node.*.bucket {
        if e.key == k { bucket = bucket.append(Entry { key: k, value: v }); found = true }
        else { bucket = bucket.append(e) }
    }
    if found { node.bucket = bucket; return false }
    let idx = ((h >> shift) & 31) as int
    node.*.kids[idx].map_or_else(
        || {
            let mut leaf = new_hnode<K, V>()
            leaf.bucket = leaf.bucket.append(Entry { key: k, value: v })
            node.kids[idx] = Some(&leaf)
            false
        },
        |child| {
            let mut next = new_hnode<K, V>()
            next.kids = slices.Clone(child.*.kids)
            next.bucket = child.*.bucket
            let replaced = hput(&next, k, v, h, shift + 5)
            node.kids[idx] = Some(&next)
            replaced
        },
    )
}

pub fn massoc<K: Comparable, V>(m: HashMap<K, V>, k: K, v: V) -> HashMap<K, V> {
    m.root.map_or_else(
        || {
            let mut node = new_hnode<K, V>()
            node.bucket = node.bucket.append(Entry { key: k, value: v })
            HashMap { n: m.n + 1, root: Some(&node), hash: m.hash }
        },
        |r| {
            let mut out = new_hnode<K, V>()
            out.kids = slices.Clone(r.*.kids)
            out.bucket = r.*.bucket
            let replaced = hput(&out, k, v, khash(k), 0)
            let new_n = if replaced { m.n } else { m.n + 1 }
            HashMap { n: new_n, root: Some(&out), hash: m.hash }
        },
    )
}

fn hdel<K: Comparable, V>(node: mut Ref<HNode<K, V>>, k: K, h: uint64, shift: int) -> bool {
    let mut found = false
    let mut bucket = Slice.new<Entry<K, V>>()
    for e in node.*.bucket {
        if e.key == k { found = true } else { bucket = bucket.append(e) }
    }
    if found { node.bucket = bucket; return true }
    let idx = ((h >> shift) & 31) as int
    node.*.kids[idx].map_or(false, |child| {
        let mut next = new_hnode<K, V>()
        next.kids = slices.Clone(child.*.kids)
        next.bucket = child.*.bucket
        let removed = hdel(&next, k, h, shift + 5)
        node.kids[idx] = Some(&next)
        removed
    })
}

pub fn mdissoc<K: Comparable, V>(m: HashMap<K, V>, k: K) -> HashMap<K, V> {
    m.root.map_or(m, |r| {
        let mut out = new_hnode<K, V>()
        out.kids = slices.Clone(r.*.kids)
        out.bucket = r.*.bucket
        if hdel(&out, k, khash(k), 0) { HashMap { n: m.n - 1, root: Some(&out), hash: m.hash } } else { m }
    })
}

// Direct entry traversal: no tuple sequence allocated (reduce-kv lesson).
fn walk_entries<K: Comparable, V>(node: Ref<HNode<K, V>>, out: Slice<Entry<K, V>>) -> Slice<Entry<K, V>> {
    let mut acc = out
    for e in node.*.bucket { acc = acc.append(e) }
    for child in node.*.kids {
        match child { Some(c) => acc = walk_entries(c, acc), None => { let _ = 0 } }
    }
    acc
}

pub fn entries<K: Comparable, V>(m: HashMap<K, V>) -> Slice<Entry<K, V>> {
    m.root.map_or_else(|| Slice.new<Entry<K, V>>(), |r| walk_entries(r, Slice.new<Entry<K, V>>()))
}

// ---------------------------------------------------------------------------
// D. Persistent set — wrapper over HashMap<T, UnitVal>. One hash implementation.
// ---------------------------------------------------------------------------

pub enum UnitVal { #[default] Only }

pub struct HashSet<T: Comparable> { pub backing: HashMap<T, UnitVal> }

pub fn empty_set<T: Comparable>() -> HashSet<T> {
    HashSet { backing: empty_map<T, UnitVal>() }
}

pub fn sconj<T: Comparable>(s: HashSet<T>, x: T) -> HashSet<T> {
    HashSet { backing: massoc(s.backing, x, UnitVal.Only) }
}

pub fn scontains<T: Comparable>(s: HashSet<T>, x: T) -> bool {
    mget(s.backing, x).is_some()
}

// ---------------------------------------------------------------------------
// E. Persistent queue — two-list functional queue, amortized O(1).
// ---------------------------------------------------------------------------

pub struct Queue<T> { pub front: List<T>, pub rear: List<T> }

pub fn empty_queue<T>() -> Queue<T> {
    Queue { front: empty_list<T>(), rear: empty_list<T>() }
}

// Reverse the rear linked list directly in place of a slice round-trip:
// O(n) with no intermediate collection; amortized O(1) per queue op.
fn reverse_list<T>(xs: List<T>, acc: List<T>) -> List<T> {
    // Iterative: no stack growth for large queue reversal.
    let mut out = acc
    let mut cur = xs
    loop {
        match cur {
            List.Empty => return out,
            List.Cons { head, tail } => { out = cons(head, out); cur = tail.* },
        }
    }
}

fn normalize<T>(q: Queue<T>) -> Queue<T> {
    match first(q.front) {
        Some(_) => q,
        None => Queue { front: reverse_list(q.rear, empty_list<T>()), rear: empty_list<T>() },
    }
}

pub fn qconj<T>(q: Queue<T>, x: T) -> Queue<T> {
    normalize(Queue { front: q.front, rear: cons(x, q.rear) })
}

pub fn qpeek<T>(q: Queue<T>) -> Option<T> { first(q.front) }

pub fn qpop<T>(q: Queue<T>) -> Queue<T> { normalize(Queue { front: rest(q.front), rear: q.rear }) }

